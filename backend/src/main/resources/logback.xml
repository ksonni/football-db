<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <conversionRule conversionWord="user" converterClass="com.ksonni.footballdb.config.UserConverter" />
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>
                %d{dd-MM-yyyy HH:mm:ss.SSS} %highlight(%-5level) %yellow([User: %user]) %logger{36}.%M - %msg%n
            </pattern>
        </encoder>
    </appender>
    <root level="info">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
