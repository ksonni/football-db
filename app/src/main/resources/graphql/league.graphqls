extend type Query {
    league(id: ID!): League
    leagues(filter: LeagueFilter = {}, sort: LeagueSort = {}, page: Pagination = {}): LeaguePage
}

type League {
    id: ID!
    name: String!
}

input LeagueFilter {
    name: StringFilter
}

input LeagueSort {
    name: Sort
}

type LeaguePage {
    content: [League!]!
    totalElements: Int!
    totalPages: Int!
    size: Int!
}
